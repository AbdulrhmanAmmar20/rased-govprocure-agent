# Copy to .env and fill in. Never commit the result.

RASED_ENVIRONMENT=development
RASED_DEBUG=true

# Sovereignty — must resolve to an in-Kingdom region (NFR-1.1)
RASED_DATA_RESIDENCY_REGION=sa-riyadh-1

# Auth — generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
RASED_JWT_SECRET=change-me
RASED_JWT_TTL_SECONDS=3600

# PII vault — generate with: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
# Leave blank to generate an ephemeral per-process key (recommended).
RASED_VAULT_KEY=

# Procurement thresholds
RASED_DIRECT_PURCHASE_CEILING_SAR=100000
RASED_MIN_LOCAL_CONTENT_RATIO=0.30

# Sovereign inference endpoint (vLLM inside the VPC)
RASED_LLM_BASE_URL=http://vllm.rased.svc.cluster.local:8000/v1
RASED_LLM_MODEL=Qwen2.5-14B-Instruct
RASED_LLM_TIMEOUT_SECONDS=5

# Retrieval
RASED_VECTOR_BACKEND=memory
